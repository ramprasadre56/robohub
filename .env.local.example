# Copy to .env.local and fill in to enable "Sign in with Google".
# Create an OAuth client (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Optional: where the SQLite database and uploaded images are stored (default ./data)
# DATA_DIR=./data
